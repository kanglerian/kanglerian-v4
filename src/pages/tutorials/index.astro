---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const tutorials = await getCollection('tutorials');
tutorials.sort((a, b) => {
	const dateA = a.data.pubDate ? a.data.pubDate.valueOf() : 0;
	const dateB = b.data.pubDate ? b.data.pubDate.valueOf() : 0;
	return dateB - dateA;
});

const categories = ['Semua', ...Array.from(new Set(tutorials.map((t) => t.data.category)))];
---

<BaseLayout
	title="Tutorial & Video"
	description="Kumpulan video tutorial coding, arsitektur software, dan panduan teknis oleh Lerian Febriana."
>
	<div class="space-y-10">
		<!-- Header -->
		<section class="space-y-2">
			<div class="text-xs font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400">
				// Panduan &amp; Video
			</div>
			<h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
				Tutorial &amp; Video
			</h1>
			<p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
				Kumpulan panduan teknis, tutorial pemrograman, dan walkthrough arsitektur sistem yang tersinkronisasi dengan kanal YouTube.
			</p>
		</section>

		<!-- Search Bar & Category Filters -->
		<section class="space-y-3">
			<div class="space-y-1.5">
				<label for="tutorial-search" class="text-xs font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400">
					Cari Tutorial
				</label>
				<input
					id="tutorial-search"
					type="search"
					placeholder="[ketik judul tutorial, topik, atau teknologi...]"
					autocomplete="off"
					class="w-full font-mono text-sm border border-neutral-300 dark:border-neutral-800 bg-transparent px-3.5 py-2.5 text-neutral-900 dark:text-neutral-100 placeholder:text-neutral-400 dark:placeholder:text-neutral-600 focus:outline-none focus:border-black dark:focus:border-white transition-colors"
				/>
			</div>

			<!-- Quick Category Buttons -->
			<div class="flex flex-wrap gap-2 text-xs font-mono pt-1">
				{categories.map((cat, idx) => (
					<button
						type="button"
						data-filter-cat={cat}
						class={`cat-filter-btn px-2.5 py-1 border transition-colors cursor-pointer ${
							idx === 0
								? 'border-neutral-900 dark:border-neutral-100 font-semibold bg-neutral-900 text-white dark:bg-white dark:text-black'
								: 'border-neutral-200 dark:border-neutral-800 text-neutral-600 dark:text-neutral-400 hover:border-black dark:hover:border-white'
						}`}
					>
						{cat}
					</button>
				))}
			</div>

			<!-- Result counter indicator -->
			<div id="result-status" class="text-xs font-mono text-neutral-400 dark:text-neutral-500 pt-1">
				Menampilkan {tutorials.length} tutorial
			</div>
		</section>

		<!-- Tutorial Cards Grid -->
		<section class="space-y-4">
			{tutorials.length === 0 ? (
				<p class="text-sm font-mono text-neutral-500">Belum ada tutorial yang ditambahkan.</p>
			) : (
				<div id="tutorials-grid" class="grid grid-cols-1 sm:grid-cols-4 gap-4">
					{tutorials.map((item) => (
						<article
							class="tutorial-card border border-neutral-300 dark:border-neutral-800 hover:border-black dark:hover:border-white p-5 flex flex-col justify-between transition-colors space-y-4 group"
							data-title={item.data.title.toLowerCase()}
							data-category={item.data.category.toLowerCase()}
							data-desc={item.data.description.toLowerCase()}
						>
							<div class="space-y-2.5">
								<div class="flex items-center justify-between text-xs font-mono">
									<span class="border border-neutral-200 dark:border-neutral-800 text-neutral-500 dark:text-neutral-400 px-1.5 py-0.5 text-[11px]">
										{item.data.category}
									</span>
									{item.data.duration && (
										<span class="text-neutral-400 dark:text-neutral-500 text-[11px]">
											durasi: {item.data.duration}
										</span>
									)}
								</div>

								<h2 class="text-base font-bold text-neutral-900 dark:text-neutral-100 group-hover:underline underline-offset-4 decoration-neutral-400">
									<a
										href={item.data.youtubeUrl}
										target="_blank"
										rel="noopener noreferrer"
									>
										{item.data.title}
									</a>
								</h2>

								<p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
									{item.data.description}
								</p>
							</div>

							<div class="space-y-3 pt-2">
								{item.data.tags && item.data.tags.length > 0 && (
									<div class="flex flex-wrap gap-1 text-[11px] font-mono text-neutral-500 dark:text-neutral-400">
										{item.data.tags.map((tag) => (
											<span class="border border-neutral-200 dark:border-neutral-800 px-1.5 py-0.5">
												#{tag}
											</span>
										))}
									</div>
								)}

								<div class="pt-2 border-t border-neutral-200 dark:border-neutral-800 flex items-center justify-between text-xs font-mono">
									<a
										href={item.data.youtubeUrl}
										target="_blank"
										rel="noopener noreferrer"
										class="underline underline-offset-4 decoration-neutral-300 hover:decoration-black dark:decoration-neutral-700 dark:hover:decoration-white font-semibold text-neutral-900 dark:text-neutral-100 flex items-center gap-1.5"
									>
										<i class="fa-brands fa-youtube text-sm"></i>
										<span>[tonton di youtube &rarr;]</span>
									</a>
									<a
										href={`/tutorials/${item.id}`}
										class="text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white underline underline-offset-2"
									>
										catatan
									</a>
								</div>
							</div>
						</article>
					))}
				</div>
			)}

			<!-- Empty State -->
			<div
				id="no-results"
				class="hidden p-8 text-center border border-dashed border-neutral-300 dark:border-neutral-800 font-mono text-xs text-neutral-500 dark:text-neutral-400 space-y-1"
			>
				<p class="font-bold text-neutral-900 dark:text-neutral-100">
					[tidak ada tutorial yang cocok]
				</p>
				<p>Coba gunakan kata kunci pencarian yang lain atau pilih kategori "Semua".</p>
			</div>
		</section>
	</div>

	<!-- Live Search & Filter Script -->
	<script>
		const searchInput = document.getElementById('tutorial-search') as HTMLInputElement | null;
		const cards = document.querySelectorAll<HTMLElement>('.tutorial-card');
		const noResults = document.getElementById('no-results');
		const statusText = document.getElementById('result-status');
		const filterButtons = document.querySelectorAll<HTMLButtonElement>('.cat-filter-btn');

		let activeCategory = 'Semua';

		function filterTutorials() {
			const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
			let visibleCount = 0;

			cards.forEach((card) => {
				const title = card.getAttribute('data-title') || '';
				const category = card.getAttribute('data-category') || '';
				const desc = card.getAttribute('data-desc') || '';

				const matchQuery = !query || title.includes(query) || category.includes(query) || desc.includes(query);
				const matchCategory = activeCategory === 'Semua' || category === activeCategory.toLowerCase();

				if (matchQuery && matchCategory) {
					card.style.display = '';
					visibleCount++;
				} else {
					card.style.display = 'none';
				}
			});

			if (noResults) {
				noResults.classList.toggle('hidden', visibleCount > 0);
			}

			if (statusText) {
				statusText.textContent = `Menampilkan ${visibleCount} dari ${cards.length} tutorial`;
			}
		}

		searchInput?.addEventListener('input', filterTutorials);

		filterButtons.forEach((btn) => {
			btn.addEventListener('click', () => {
				activeCategory = btn.getAttribute('data-filter-cat') || 'Semua';

				filterButtons.forEach((b) => {
					const isCurrent = b === btn;
					b.classList.toggle('bg-neutral-900', isCurrent);
					b.classList.toggle('text-white', isCurrent);
					b.classList.toggle('dark:bg-white', isCurrent);
					b.classList.toggle('dark:text-black', isCurrent);
					b.classList.toggle('border-neutral-900', isCurrent);
					b.classList.toggle('dark:border-neutral-100', isCurrent);
					b.classList.toggle('font-semibold', isCurrent);
				});

				filterTutorials();
			});
		});
	</script>
</BaseLayout>
