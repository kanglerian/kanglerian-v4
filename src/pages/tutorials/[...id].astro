---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const tutorials = await getCollection('tutorials');
	return tutorials.map((item) => ({
		params: { id: item.id },
		props: { item },
	}));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<BaseLayout
	title={item.data.title}
	description={item.data.description}
	ogType="article"
>
	<article class="space-y-8">
		<!-- Back to list -->
		<div>
			<a
				href="/tutorials"
				class="text-xs font-mono uppercase tracking-wider text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors underline underline-offset-4"
			>
				&larr; [kembali ke katalog tutorial]
			</a>
		</div>

		<!-- Tutorial Header -->
		<header class="space-y-4 border-b border-neutral-200 dark:border-neutral-800 pb-6">
			<div class="flex items-center gap-3 text-xs font-mono text-neutral-500 dark:text-neutral-400">
				<span>Kategori: {item.data.category}</span>
				{item.data.duration && (
					<span>&bull;</span>
					<span>Durasi: {item.data.duration}</span>
				)}
			</div>

			<h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
				{item.data.title}
			</h1>

			<p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
				{item.data.description}
			</p>

			<!-- Action YouTube Link -->
			<div class="pt-2">
				<a
					href={item.data.youtubeUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2 border border-neutral-300 dark:border-neutral-700 hover:border-black dark:hover:border-white px-4 py-2 text-xs font-mono font-semibold transition-colors text-neutral-900 dark:text-neutral-100"
				>
					<i class="fa-brands fa-youtube text-base"></i>
					<span>[Tonton Video di YouTube &rarr;]</span>
				</a>
			</div>
		</header>

		<!-- Tutorial Notes / Markdown Content -->
		<div class="markdown-body text-neutral-800 dark:text-neutral-200">
			<Content />
		</div>
	</article>
</BaseLayout>

<style is:global>
	.markdown-body h2 {
		font-family: var(--font-sans);
		font-size: 1.35rem;
		font-weight: 700;
		color: currentColor;
		margin-top: 2.25rem;
		margin-bottom: 0.75rem;
		letter-spacing: -0.02em;
	}
	.markdown-body h3 {
		font-family: var(--font-sans);
		font-size: 1.15rem;
		font-weight: 600;
		color: currentColor;
		margin-top: 1.75rem;
		margin-bottom: 0.5rem;
	}
	.markdown-body p {
		font-size: 0.95rem;
		line-height: 1.75;
		margin-bottom: 1.25rem;
	}
	.markdown-body ul,
	.markdown-body ol {
		margin-top: 0.5rem;
		margin-bottom: 1.25rem;
		padding-left: 1.5rem;
		font-size: 0.95rem;
		line-height: 1.7;
	}
	.markdown-body ul {
		list-style-type: disc;
	}
	.markdown-body ol {
		list-style-type: decimal;
	}
	.markdown-body li {
		margin-bottom: 0.35rem;
	}
	.markdown-body pre {
		padding: 1rem;
		border: 1px solid;
		overflow-x: auto;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		line-height: 1.5;
		margin-top: 1.25rem;
		margin-bottom: 1.25rem;
	}
	.markdown-body code:not(pre code) {
		font-family: var(--font-mono);
		font-size: 0.85em;
		padding: 0.15rem 0.35rem;
		border: 1px solid;
	}

	/* Light mode */
	html:not(.dark) .markdown-body pre {
		background-color: #f5f5f5;
		border-color: #e5e5e5;
		color: #171717;
	}
	html:not(.dark) .markdown-body code:not(pre code) {
		background-color: #f5f5f5;
		border-color: #e5e5e5;
		color: #171717;
	}

	/* Dark mode */
	html.dark .markdown-body pre {
		background-color: #0a0a0a;
		border-color: #262626;
		color: #f5f5f5;
	}
	html.dark .markdown-body code:not(pre code) {
		background-color: #171717;
		border-color: #262626;
		color: #f5f5f5;
	}
</style>
