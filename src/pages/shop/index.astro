---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { shopItems as items } from '../../content/shop/data.js';
---

<BaseLayout
	title="Shop & Gear List"
	description="Katalog rekomendasi perangkat keras, setup meja kerja, dan buku pilihan Lerian Febriana."
>
	<div class="space-y-10">
		<!-- Header -->
		<section class="space-y-2">
			<div class="text-xs font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400">
				// Katalog &amp; Rekomendasi
			</div>
			<h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
				Shop &amp; Gear List
			</h1>
			<p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
				Katalog perkakas kerja, aksesori meja (*desk setup*), buku, dan perlengkapan harian yang saya gunakan serta rekomendasikan.
			</p>
		</section>

		<!-- Search Bar -->
		<section class="space-y-3">
			<div class="space-y-1.5">
				<label for="shop-search" class="text-xs font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400">
					Cari Barang
				</label>
				<input
					id="shop-search"
					type="search"
					placeholder="[ketik nama barang atau deskripsi...]"
					autocomplete="off"
					class="w-full font-mono text-sm border border-neutral-300 dark:border-neutral-800 bg-transparent px-3.5 py-2.5 text-neutral-900 dark:text-neutral-100 placeholder:text-neutral-400 dark:placeholder:text-neutral-600 focus:outline-none focus:border-black dark:focus:border-white transition-colors"
				/>
			</div>

			<!-- Result counter indicator -->
			<div id="result-status" class="text-xs font-mono text-neutral-400 dark:text-neutral-500 pt-1">
				Menampilkan {items.length} barang
			</div>
		</section>

		<!-- Cards Grid (Dengan Cover Gambar) -->
		<section class="space-y-4">
			<div id="shop-grid" class="grid grid-cols-2 sm:grid-cols-6 gap-4">
				{items.map((item) => (
					<article
						class="shop-card border border-neutral-300 dark:border-neutral-800 hover:border-black dark:hover:border-white flex flex-col justify-between transition-colors group overflow-hidden"
						data-title={item.title.toLowerCase()}
						data-desc={item.description.toLowerCase()}
					>
						<div>
							<!-- Cover Barang (1:1) -->
							<a
								href={item.url}
								target="_blank"
								rel="noopener noreferrer"
								class="block aspect-square w-full overflow-hidden border-b border-neutral-300 dark:border-neutral-800 bg-neutral-100 dark:bg-neutral-900 relative"
							>
								{item.image ? (
									<img
										src={item.image}
										alt={item.title}
										loading="lazy"
										class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
									/>
								) : (
									<div class="w-full h-full flex items-center justify-center font-mono text-xs text-neutral-400 dark:text-neutral-600">
										[tanpa cover]
									</div>
								)}
							</a>

							<div class="p-4 space-y-2">
								<h2 class="text-sm sm:text-base font-bold text-neutral-900 dark:text-neutral-100">
									{item.title}
								</h2>

								<p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
									{item.description}
								</p>
							</div>
						</div>

						<div class="px-4 pb-4">
							<div class="pt-3 border-t border-neutral-200 dark:border-neutral-800 flex items-center justify-end text-xs font-mono">
								<a
									href={item.url}
									target="_blank"
									rel="noopener noreferrer"
									class="underline underline-offset-4 decoration-neutral-300 hover:decoration-black dark:decoration-neutral-700 dark:hover:decoration-white font-semibold text-neutral-900 dark:text-neutral-100 transition-colors"
								>
									[lihat &rarr;]
								</a>
							</div>
						</div>
					</article>
				))}
			</div>

			<!-- Empty State -->
			<div
				id="no-results"
				class="hidden p-8 text-center border border-dashed border-neutral-300 dark:border-neutral-800 font-mono text-xs text-neutral-500 dark:text-neutral-400 space-y-1"
			>
				<p class="font-bold text-neutral-900 dark:text-neutral-100">
					[tidak ada barang yang cocok]
				</p>
				<p>Coba gunakan kata kunci pencarian yang lain.</p>
			</div>
		</section>
	</div>

	<!-- Live Search Script -->
	<script>
		const searchInput = document.getElementById('shop-search') as HTMLInputElement | null;
		const cards = document.querySelectorAll<HTMLElement>('.shop-card');
		const noResults = document.getElementById('no-results');
		const statusText = document.getElementById('result-status');

		function filterItems() {
			const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
			let visibleCount = 0;

			cards.forEach((card) => {
				const title = card.getAttribute('data-title') || '';
				const desc = card.getAttribute('data-desc') || '';

				const matchQuery = !query || title.includes(query) || desc.includes(query);

				if (matchQuery) {
					card.style.display = '';
					visibleCount++;
				} else {
					card.style.display = 'none';
				}
			});

			if (noResults) {
				noResults.classList.toggle('hidden', visibleCount > 0);
			}

			if (statusText) {
				statusText.textContent = `Menampilkan ${visibleCount} dari ${cards.length} barang`;
			}
		}

		searchInput?.addEventListener('input', filterItems);
	</script>
</BaseLayout>
