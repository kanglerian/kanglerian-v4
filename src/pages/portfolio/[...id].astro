---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const projects = await getCollection('portfolio');
	return projects.map((project) => ({
		params: { id: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout
	title={project.data.title}
	description={project.data.description}
	ogType="article"
>
	<article class="space-y-8">
		<!-- Back to list -->
		<div>
			<a
				href="/portfolio"
				class="text-xs font-mono uppercase tracking-wider text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors underline underline-offset-4"
			>
				&larr; [kembali ke katalog portofolio]
			</a>
		</div>

		<!-- Project Header -->
		<header class="space-y-4 border-b border-neutral-200 dark:border-neutral-800 pb-6">
			<div class="flex items-center gap-3 text-xs font-mono text-neutral-500 dark:text-neutral-400">
				<span>Tahun: {project.data.year}</span>
				{project.data.featured && (
					<span>&bull;</span>
					<span>[featured project]</span>
				)}
			</div>

			<h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
				{project.data.title}
			</h1>

			<p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
				{project.data.description}
			</p>

			<!-- Meta Links & Tech Stack -->
			<div class="pt-2 space-y-3 font-mono text-xs">
				{project.data.stack && project.data.stack.length > 0 && (
					<div class="flex flex-wrap items-center gap-1.5">
						<span class="text-neutral-400 dark:text-neutral-500">Tech:</span>
						{project.data.stack.map((tech) => (
							<span class="border border-neutral-200 dark:border-neutral-800 px-1.5 py-0.5">
								{tech}
							</span>
						))}
					</div>
				)}

				<div class="flex items-center gap-4">
					{project.data.github && (
						<a
							href={project.data.github}
							target="_blank"
							rel="noopener noreferrer"
							class="text-neutral-900 dark:text-neutral-100 underline underline-offset-2 hover:opacity-80"
						>
							[lihat di github &rarr;]
						</a>
					)}
					{project.data.link && project.data.link !== project.data.github && (
						<a
							href={project.data.link}
							target="_blank"
							rel="noopener noreferrer"
							class="text-neutral-900 dark:text-neutral-100 underline underline-offset-2 hover:opacity-80"
						>
							[kunjungi website &rarr;]
						</a>
					)}
				</div>
			</div>
		</header>

		<!-- Project Body / Case Study -->
		<div class="markdown-body text-neutral-800 dark:text-neutral-200">
			<Content />
		</div>
	</article>
</BaseLayout>

<style is:global>
	.markdown-body h2 {
		font-family: var(--font-sans);
		font-size: 1.35rem;
		font-weight: 700;
		color: currentColor;
		margin-top: 2.25rem;
		margin-bottom: 0.75rem;
		letter-spacing: -0.02em;
	}
	.markdown-body h3 {
		font-family: var(--font-sans);
		font-size: 1.15rem;
		font-weight: 600;
		color: currentColor;
		margin-top: 1.75rem;
		margin-bottom: 0.5rem;
	}
	.markdown-body p {
		font-size: 0.95rem;
		line-height: 1.75;
		margin-bottom: 1.25rem;
	}
	.markdown-body ul,
	.markdown-body ol {
		margin-top: 0.5rem;
		margin-bottom: 1.25rem;
		padding-left: 1.5rem;
		font-size: 0.95rem;
		line-height: 1.7;
	}
	.markdown-body ul {
		list-style-type: disc;
	}
	.markdown-body ol {
		list-style-type: decimal;
	}
	.markdown-body li {
		margin-bottom: 0.35rem;
	}
	.markdown-body pre {
		padding: 1rem;
		border: 1px solid;
		overflow-x: auto;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		line-height: 1.5;
		margin-top: 1.25rem;
		margin-bottom: 1.25rem;
	}
	.markdown-body code:not(pre code) {
		font-family: var(--font-mono);
		font-size: 0.85em;
		padding: 0.15rem 0.35rem;
		border: 1px solid;
	}
	.markdown-body a {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	/* Light mode */
	html:not(.dark) .markdown-body pre {
		background-color: #f5f5f5;
		border-color: #e5e5e5;
		color: #171717;
	}
	html:not(.dark) .markdown-body code:not(pre code) {
		background-color: #f5f5f5;
		border-color: #e5e5e5;
		color: #171717;
	}

	/* Dark mode */
	html.dark .markdown-body pre {
		background-color: #0a0a0a;
		border-color: #262626;
		color: #f5f5f5;
	}
	html.dark .markdown-body code:not(pre code) {
		background-color: #171717;
		border-color: #262626;
		color: #f5f5f5;
	}
</style>
